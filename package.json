{
  "name": "deutsch-drill",
  "version": "0.1.0",
  "description": "Drill German grammar: verb conjugation and more. Configured through TOML files.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "test": "vitest run",
    "check": "node src/server/check.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "install-app": "npm run build && sh scripts/install-app.sh"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
